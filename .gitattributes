# Set default behavior to let Git handle it automatically
* text=auto

# Force some files to always use LF (regardless of OS)
*.py text eol=lf
*.sh text eol=lf
*.service text eol=lf
.gitattributes text eol=lf

# Explicitly set Windows files to CRLF if they require it
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
